
# Root domain to use for all services
DEV_DOMAIN=127.0.0.1.nip.io

# Host ports the stack claims (change to run several stacks side by side).
# Note: if you change these, app .env URLs that embed them (e.g. SDS_URL,
# anything on http://<host>.${DEV_DOMAIN}) must be updated to match.
#TRAEFIK_HTTP_PORT=80
#SDS_TCP_PORT=5333

# Global username and password used for everything
DEV_USER=admin
DEV_PASSWORD=P@ssw0rd

# Global username and password used for everything - but URL encoded - this is needed for connection strings
# as some passwords might have special symbols in them, such as "@", causing database connection strings to fail
# For example, if your DEV_PASSWORD is "strong_p@ssword", in DEV_PASSWORD_URL_ENCODED, it must be "strong_p%40ssword"
DEV_USER_URL_ENCODED=admin
DEV_PASSWORD_URL_ENCODED=P%40ssw0rd

# --- IMAGE TAGS ---
# All the AGIL Ops Hub container images are available here to make changing it more convenient.
# During development, you may want to use `latest-dev` for certain specific images, in that case, you can
# just add "-dev" behind the individual environment variables, for example, with `DASH_SERVICE_TAG=v2.0.2`,
# you can change it to `DASH_SERVICE_TAG=latest-dev`. Alternatively, you can also change the global tag itself
# to switch all tags to latest-dev, e.g. `GLOBAL_TAG=latest-dev`.
GLOBAL_TAG=latest

# --- IAMS ---
IAMS_KEYCLOAK_TAG=v1.5.1
IAMS_AAS_TAG=v1.3.7
IAMS_WEB_TAG=v2.4.3

# --- SDS ---
SDS_SERVER_TAG=v1.0.0

# --- RTUS ---
RTUS_PMS_TAG=v1.2.0
RTUS_SEH_TAG=v1.2.2

# --- GIS (ops-hub image: ghcr.io/mssfoobar/ops-hub/gis-service) ---
# The map UI is an SDK a host app embeds (aoh-gis-integration skill), not a
# separately-deployed image.
GIS_SERVICE_TAG=v3.0.0

# --- IAN ---
IAN_APP_TAG=v1.0.2
IAN_WEB_TAG=v1.0.5

# --- DASH (ops-hub image: ghcr.io/mssfoobar/ops-hub/dash-service) ---
DASH_SERVICE_TAG=v3.0.0

# --- AMM ---
AMM_APP_TAG=v1.1.0

# --- FORM (ops-hub image: ghcr.io/mssfoobar/ops-hub/form-service) ---
# The form authoring Creator + renderer are an SDK a host app embeds
# (aoh-form-integration skill), not a separately-deployed image.
FORM_SERVICE_TAG=v1.0.0
# Commercial SurveyJS licence key for a host app embedding form-web-sdk — leave
# blank for development/evaluation.
SURVEYJS_KEY=

# --- PTMGR ---
PTMGR_APP_TAG=v1.0.1

# --- UNH (ops-hub image: ghcr.io/mssfoobar/ops-hub/unh-service) ---
# The notification admin UI is an SDK a host app embeds (aoh-unh-integration
# skill), not a separately-deployed image.
UNH_SERVICE_TAG=v1.0.0

# --- WFE (ops-hub images: ghcr.io/mssfoobar/ops-hub/wfe-*) ---
# The activity worker is consumer-owned (scaffold it with the aoh-wfe-worker
# skill); its image is set directly in the compose, not here.
WFE_MANAGER_TAG=v3.0.0
WFE_ENGINE_TAG=v3.0.0

# --- OBSERVABILITY (OpenTelemetry) ---
# The gateway OTEL collector is core (always on) — the OTLP endpoint every
# service targets. Services export here by default; unset to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# --- SIGNOZ (observability backend) ---
# Pinned upstream versions; these are NOT subject to GLOBAL_TAG.
SIGNOZ_VERSION=v0.129.0
SIGNOZ_OTELCOL_TAG=v0.144.5
CLICKHOUSE_TAG=25.5.6
# SigNoz's internal token-signing secret. The compose falls back to a weak
# dev default ("secret") when unset; uncomment and set a strong value for any
# non-throwaway deployment (left commented so promotion can't carry the weak
# default silently).
# SIGNOZ_JWT_SECRET=
# Air-gap: point histogram-quantile downloads at an internal mirror. Defaults
# to GitHub releases when unset.
# HISTOGRAM_QUANTILE_BASE_URL=https://github.com/SigNoz/signoz/releases/download
