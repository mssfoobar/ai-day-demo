{
	"name": "@mssfoobar/__AOH_MODULE_NAME__-web-sdk",
	"version": "0.0.0",
	"private": true,
	"description": "AGIL Ops Hub __AOH_MODULE_NAME__ module — Svelte SDK.",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "npm run package",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package -i ./sdk && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mssfoobar/ops-hub.git",
		"directory": "modules/__AOH_MODULE_NAME__/web"
	},
	"homepage": "https://github.com/mssfoobar/ops-hub/tree/develop/modules/__AOH_MODULE_NAME__/web",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"license": "UNLICENSED",
	"peerDependencies": {
		"@mssfoobar/__AOH_MODULE_NAME__-client": "workspace:*",
