		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24.10.12",
		"@vitest/coverage-v8": "^4.0.18",
		"jsdom": "^27.4.0",
		"publint": "^0.3.18",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
