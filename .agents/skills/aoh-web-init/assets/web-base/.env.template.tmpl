# {APP_NAME} — AOH SvelteKit env template.
# Step 5 copies this to .env.development for local `pnpm dev`. Values target the
# composed AOH stack (Traefik routes each service at <svc>.${PUBLIC_DOMAIN}); keep
# them in sync with compose/.env from the `aoh-compose` step.

# --- OIDC (Keycloak) — server-side, read in hooks.server.ts ---
# IAM_URL is the realm base; openid-client appends /.well-known/openid-configuration.
IAM_URL=http://iams-keycloak.127.0.0.1.nip.io/realms/aoh
IAM_CLIENT_ID=web
IAM_CLIENT_SECRET=
# Allow http OIDC discovery in local dev (Traefik serves Keycloak over http).
OIDC_ALLOW_INSECURE_REQUESTS=1

# --- Public (browser-exposed) ---
PUBLIC_DOMAIN=127.0.0.1.nip.io
PUBLIC_COOKIE_PREFIX=web
PUBLIC_COOKIE_SAMESITE=lax
PUBLIC_STATIC_BUILD_VERSION=dev

# --- Server runtime ---
ORIGIN=http://127.0.0.1.nip.io:5173
SDS_URL=tcp://127.0.0.1:5333

# --- OpenTelemetry (server + BFF tracing via @mssfoobar/observability) ---
# Unset = disabled (no-op). Point at the per-spoke gateway Collector to enable
# (the `otel` aoh-compose fragment exposes OTLP gRPC on 4317).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
# Post-login landing route. Update when you add a real landing page (and in
# compose/<app>/compose.yml). Never set to "/" — that infinite-loops the login.
LOGIN_DESTINATION=/getting-started
# LOGIN_PAGE=/aoh/api/auth/login   # default; uncomment only to override

# --- Backend gateway upstreams (configure the matching modules in gateway.config.ts) ---
# One URL per backend module reachable through /aoh/gateway/<module>/..., e.g.:
# INCIDENT_URL=http://localhost:8081
