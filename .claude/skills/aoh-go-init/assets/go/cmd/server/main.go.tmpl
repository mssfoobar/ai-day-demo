package main

import (
	"context"
	"log"
	"os"
	"os/signal"
	"syscall"
	"time"

	aohotel "github.com/mssfoobar/ops-hub/packages/aoh-golib/otel"
)

// @title           __AOH_TITLE__ API
// @version         1.0
// @BasePath        /
func main() {
	// OpenTelemetry: sets the W3C propagators always and exports traces/metrics/
	// logs via OTLP when OTEL_EXPORTER_OTLP_ENDPOINT is set (the per-spoke gateway
	// Collector); a no-op otherwise, so this is safe in every environment.
	otelShutdown, err := aohotel.Init(context.Background(), aohotel.Config{
		ServiceName: "__AOH_NAME__",
	})
	if err != nil {
		log.Fatal(err)
	}
	defer func() {
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := otelShutdown(ctx); err != nil {
			log.Printf("otel shutdown: %v", err)
		}
	}()

	srv, err := InitService()
	if err != nil {
		log.Fatal(err)
	}

	quitCh := make(chan os.Signal, 1)
	signal.Notify(quitCh, os.Interrupt, syscall.SIGTERM)
	<-quitCh

	srv.Stop()
}
