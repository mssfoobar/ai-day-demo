# AOH Hub Nexus — laptop profile env
#
# Copy to .env and edit for your machine. ./scripts/up.sh will do this
# automatically on first run if .env is missing.

# ---------- Nexus ----------
# Web UI + REST API port on localhost. 8181 avoids clash with other JVM tooling.
NEXUS_HTTP_PORT=8181
# Host-side port for the Docker Hub pull-through proxy. Docker clients need
# this as a separate host:port (Docker Registry v2 can't path-route). The
# Nexus-internal connector is always 8182 regardless of what you set here —
# changing this only changes the host-side mapping in compose.laptop.yml.
NEXUS_DOCKER_PROXY_HOST_PORT=8182

# ---------- Admin ----------
# Admin password that bootstrap.sh will set on first run. After that, change
# it in the UI if you want — this env var is only read during bootstrap.
# Default is "aohadmin" for laptop-throwaway use. Change for anything else.
# Quote the value if it contains spaces or shell metacharacters ($, !, `, ")
# — e.g. NEXUS_ADMIN_PASSWORD='p@ss w0rd!'. Passwords starting with '@' are
# safe (bootstrap uses curl --data-raw to avoid the file-read interpretation).
NEXUS_ADMIN_PASSWORD=aohadmin

# ---------- Proxy repo set ----------
# Which proxy formats bootstrap.sh creates. Trim this list to skip formats
# you don't need (each proxy takes disk on first resolve). The defaults
# cover every ecosystem the AOH stack currently uses.
#
# Known values: maven npm pypi go apt yum docker
NEXUS_PROXY_FORMATS="maven npm pypi go apt yum docker"

# ---------- Hosted repo set ----------
# Which hosted formats bootstrap.sh creates for internal publishing.
# NOTE: docker is intentionally NOT included — internal container images
# belong in Harbor (AOH-6739), not Nexus. Do not add `docker` here without
# revisiting that decision.
NEXUS_HOSTED_FORMATS="maven npm pypi raw"

# ---------- APT / YUM proxy targets ----------
# APT proxy needs a specific Ubuntu distribution codename. YUM proxy needs
# a base URL for the RHEL/Rocky version. Change these to match the OS your
# target projects actually build against.
NEXUS_APT_DISTRIBUTION=noble
NEXUS_APT_REMOTE_URL=http://archive.ubuntu.com/ubuntu/
NEXUS_YUM_REMOTE_URL=https://download.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/
