{
	// Podman is the runtime for this repo. Set these in VS Code user settings first:
	//   "dev.containers.dockerPath": "podman"
	//   "dev.containers.dockerComposePath": "podman-compose"
	"name": "fleet-dispatch-console workshop",
	"dockerComposeFile": ["../compose/compose.yml", "../compose/compose.devcontainer.yml"],
	"service": "workshop",
	"workspaceFolder": "/workspace",
	"remoteUser": "node",
	"overrideCommand": false,
	"shutdownAction": "stopCompose",

	"forwardPorts": [5173, 8081],
	"portsAttributes": {
		"5173": { "label": "console", "onAutoForward": "openBrowserOnce" },
		"8081": { "label": "dispatch-svc", "onAutoForward": "silent" }
	},

	// One of the two variables is empty on any given platform, so the pair expands to a
	// single home directory. Create ~/.npmrc before first open: a missing file is
	// mounted as an empty directory.
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.npmrc,target=/home/node/.npmrc,type=bind",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind"
	],

	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode",
				"golang.go",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"anthropic.claude-code"
			],
			"settings": {
				"go.gopath": "/home/node/go",
				"go.toolsManagement.autoUpdate": false
			}
		}
	}
}
