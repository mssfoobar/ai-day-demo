# dispatch-web — local dev env, CHECKED IN on purpose.
#
# `pnpm dev` reads this file through env-cmd and fails outright if it is missing,
# so shipping it is what gives every workshop attendee an identical start state.
# It holds no secret.
#
# This app has NO authentication: no Keycloak, no Traefik, no IAMS, no SDS.
# Nothing here needs a container. `pnpm dev` is the whole run story.

# --- Server runtime ---
ORIGIN=http://localhost:5173

# --- Public (browser-exposed) ---
PUBLIC_STATIC_BUILD_VERSION=dev

# --- Security headers (hooks.server.ts warns when unset) ---
# Double-quoted so dotenv strips the OUTER quotes and the CSP keyword `'self'` survives.
# Bare `self` is parsed by CSP as a host named "self", which matches nothing and blocks
# all framing including same-origin.
FRAME_ANCESTORS="'self'"
X_FRAME_OPTIONS=SAMEORIGIN

# --- OpenTelemetry --- unset exporter endpoint = no-op.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# --- Dispatch service (read server-side; never exposed to the browser) ---
DISPATCH_SVC_URL=http://localhost:8081
