# dispatch-web — local dev env, CHECKED IN on purpose.
#
# `pnpm dev` reads this file through env-cmd and fails outright if it is missing,
# so shipping it is what gives every workshop attendee an identical start state.
# It holds no secret — the password is the stack's shipped dev default.
#
# The console authenticates against the bundled `aoh` realm and needs the compose
# stack up: iams-keycloak, iams-aas, sds-server, valkey, rtus-* and gis-service.
# See SETUP.md at the repo root.

# --- Server runtime ---
# MUST be the ${DEV_DOMAIN} origin, not localhost. The session cookie is issued on this
# origin, and only a cookie issued on the parent domain reaches rtus-seh.${DEV_DOMAIN} —
# which is what authorises the map's SSE subscription. rtus-seh's CORS allow-list also
# already contains exactly this origin. On plain localhost the map silently never
# connects, with nothing in either log to explain it.
ORIGIN=http://127.0.0.1.nip.io:5173

# --- OIDC / Keycloak ---
# The realm's bundled public `web` client. Do not register a per-app client: `web` has
# wildcard redirect URIs for local dev, which is why no realm edit is needed here.
IAM_URL=http://iams-keycloak.127.0.0.1.nip.io/realms/aoh
IAM_CLIENT_ID=web
# NOT optional over plain http. OIDC discovery runs in a TOP-LEVEL await in
# hooks.server.ts, so without this the server throws at startup and EVERY route —
# including /livez and /readyz — returns 500.
OIDC_ALLOW_INSECURE_REQUESTS=1

# --- Session Data Store ---
# Tokens live here, server-side. The browser only ever holds `web_auth_session_id`.
# Traefik publishes sds-server's TCP 5333 on the host, so localhost is correct here.
SDS_URL=tcp://127.0.0.1:5333

# --- Public (browser-exposed) ---
PUBLIC_DOMAIN=127.0.0.1.nip.io
# Platform default. Produces the cookie name `web_auth_session_id`, which is the value
# already seeded on rtus-seh's `rtus.session-id.cookienames`. Changing it means editing
# compose/rtus/compose.yml too.
PUBLIC_COOKIE_PREFIX=web
PUBLIC_COOKIE_SAMESITE=lax
PUBLIC_RTUS_SEH_URL=http://rtus-seh.127.0.0.1.nip.io
PUBLIC_STATIC_BUILD_VERSION=dev

# --- Post-login landing ---
LOGIN_DESTINATION=/aoh/dispatch/units

# --- Security headers (hooks.server.ts warns when unset) ---
# Double-quoted so dotenv strips the OUTER quotes and the CSP keyword `'self'` survives.
# Bare `self` is parsed by CSP as a host named "self", which matches nothing and blocks
# all framing including same-origin.
FRAME_ANCESTORS="'self'"
X_FRAME_OPTIONS=SAMEORIGIN

# --- OpenTelemetry --- unset exporter endpoint = no-op.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# --- Dispatch service (read server-side; never exposed to the browser) ---
DISPATCH_SVC_URL=http://localhost:8081
