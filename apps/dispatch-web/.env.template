# dispatch-web — AOH SvelteKit env template.
#
# Copied to .env.development for local `pnpm dev` (that file is checked in, so you
# normally do not need to do this yourself).
#
# The console authenticates through IAMS. `IAM_URL`, `IAM_CLIENT_ID`, `ORIGIN`,
# `PUBLIC_COOKIE_PREFIX`, `LOGIN_DESTINATION` and `SDS_URL` are all load-bearing:
# hooks.server.ts refuses to start without the required ones rather than serving a
# half-configured app.

# --- Server runtime ---
# Must match the origin the dev server is served on, and must be the ${DEV_DOMAIN}
# origin rather than localhost: the session cookie has to be issued on a parent of
# rtus-seh.${DEV_DOMAIN} for the map's SSE subscription to carry it, and rtus-seh's
# CORS allow-list already contains this exact origin.
ORIGIN=http://127.0.0.1.nip.io:5173

# --- OIDC / Keycloak ---
# The realm's bundled public `web` client — shared by every AOH web app in dev.
IAM_URL=http://iams-keycloak.127.0.0.1.nip.io/realms/aoh
IAM_CLIENT_ID=web
# Required over plain http: OIDC discovery runs in a top-level await, so without this
# the server fails at startup and every route returns 500.
OIDC_ALLOW_INSECURE_REQUESTS=1

# --- Session Data Store ---
# Mandatory for an AOH web app. Tokens are held here, server-side; the browser gets
# only the opaque session-id cookie. The cookie-only fallback in auth.ts is a
# diagnostic mode, not a posture to run.
SDS_URL=tcp://127.0.0.1:5333

# --- Public (browser-exposed) ---
PUBLIC_DOMAIN=127.0.0.1.nip.io
# Platform default — produces `web_auth_session_id`, the cookie name rtus-seh is
# already seeded with. Deviating means editing compose/rtus/compose.yml as well.
PUBLIC_COOKIE_PREFIX=web
PUBLIC_COOKIE_SAMESITE=lax
PUBLIC_RTUS_SEH_URL=http://rtus-seh.127.0.0.1.nip.io
PUBLIC_STATIC_BUILD_VERSION=dev

# --- Post-login landing ---
LOGIN_DESTINATION=/aoh/dispatch/units

# --- Security headers ---
# Double-quoted so dotenv strips the OUTER quotes and the CSP keyword `'self'` survives.
# Bare `self` is parsed by CSP as a host named "self", which matches nothing and blocks
# all framing including same-origin.
FRAME_ANCESTORS="'self'"
X_FRAME_OPTIONS=SAMEORIGIN

# --- OpenTelemetry (server tracing via @mssfoobar/observability) ---
# Unset = disabled (no-op). Point at an OTLP gRPC collector to enable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# --- Dispatch service (read server-side; never exposed to the browser) ---
DISPATCH_SVC_URL=http://localhost:8081
