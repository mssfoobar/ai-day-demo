{
	"name": "@mssfoobar/dispatch-web",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@10.16.1",
	"scripts": {
		"dev": "env-cmd -f .env.development --silent vite dev --host | pino-pretty -c -l -t",
		"build": "vite build",
		"preview": "env-cmd -f .env.development --silent vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest run --coverage --watch false",
		"test:unit:dev": "vitest watch --ui --api 9527 --coverage",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"prettier --check --write",
			"eslint"
		],
		"*.{css,md,html,json}": [
			"prettier --check --write"
		]
	},
	"dependencies": {
		"@floating-ui/dom": "1.6.13",
		"@fontsource-variable/geist": "5.2.8",
		"@iconify/utils": "2.2.1",
		"@lucide/svelte": "0.479.0",
		"@mssfoobar/ui": "^1.1.0",
		"@mssfoobar/errors": "^0.1.0",
		"@mssfoobar/logger": "^1.0.5",
		"@mssfoobar/observability": "^0.1.0",
		"@mssfoobar/sse-client": "1.2.0",
		"@opentelemetry/api": "1.9.1",
		"change-case-all": "2.1.0",
		"http-status-codes": "2.3.0",
		"rough-notation": "0.5.1"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.4",
		"@eslint/js": "10.0.1",
		"@iconify-json/lucide": "1.2.19",
		"@iconify-json/mdi": "1.2.2",
		"@iconify-json/mdi-light": "1.2.1",
		"@iconify/tailwind4": "1.0.6",
		"@mssfoobar/cli": "2.3.0-alpha.0",
		"@playwright/test": "1.60.0",
		"@sveltejs/adapter-node": "5.5.6",
		"@sveltejs/kit": "2.57.0",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@tailwindcss/vite": "4.2.2",
		"@types/node": "24",
		"@vitest/coverage-v8": "4.1.4",
		"@vitest/ui": "4.1.4",
		"clsx": "2.1.1",
		"concurrently": "9.1.0",
		"env-cmd": "10.1.0",
		"eslint": "10.2.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.17.0",
		"globals": "17.4.0",
		"lint-staged": "15.3.0",
		"pino-pretty": "13.0.0",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "3.5.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte": "5.55.2",
		"svelte-check": "4.4.6",
		"tailwind-merge": "2.6.0",
		"tailwindcss": "4.2.2",
		"tw-animate-css": "1.2.1",
		"typescript": "6.0.2",
		"typescript-eslint": "8.58.1",
		"vite": "8.0.7",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "4.1.4"
	}
}
