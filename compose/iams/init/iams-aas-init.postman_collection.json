				{
					"name": "2. Create Development Tenant",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Created New Tenant\", function () {",
									"    if (pm.response.code === 201) {",
									"        var tenant_id = pm.response.text();",
									"        pm.execution.setNextRequest(\"3. Create Memebership\");",
									"        pm.collectionVariables.set(\"TENANT_ID\", tenant_id);",
									"    } else {",
									"        const token_endpoint = `${pm.environment.get(\"IAM_ENDPOINT\")}/realms/${pm.environment.get(\"IAM_REALM\")}/protocol/openid-connect/token`;",
									"        const username = pm.environment.get(\"DEV_USER\");",
									"        const password = pm.environment.get(\"DEV_PASSWORD\");",
									"        const bearer_token = pm.collectionVariables.get(\"BEARER_TOKEN\")",
									"",
									"        console.error({ error: pm.response.json(), token_endpoint, username, password, bearer_token }, \"Error creating tenant!\");",
									"        pm.execution.setNextRequest(null);",
									"    }",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"development\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{IAMS_AAS_ENDPOINT}}/admin/tenants",
