					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Setup Status\", function () {",
									"    if (pm.response.code === 201) {",
									"        console.log(\"Success!\");",
									"    } else {",
									"        console.error(\"Failure! Please manually create your tenant membership.\");",
									"    }",
