{
  "name": "fleet-dispatch-console",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "verify": "turbo run lint check-types build",
    "start": "node scripts/dev.mjs",
    "start:no-infra": "node scripts/dev.mjs --no-infra",
    "stop": "podman compose -f compose/compose.yml down",
    "reset": "podman compose -f compose/compose.yml down -v",
    "e2e": "node scripts/e2e-smoke.mjs",
    "slides": "pnpm -C slides install && pnpm -C slides dev",
    "doctor": "node scripts/doctor.mjs"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "pnpm": "10.16.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  }
}
