{
  "name": "fleet-dispatch-console",
  "private": true,
  "scripts": {
    "bootstrap": "corepack pnpm install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test:unit",
    "test:e2e": "turbo run test:integration",
    "verify": "turbo run lint check-types build test:unit"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "pnpm": "10.16.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  }
}
